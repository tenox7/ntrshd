/* ntrshd resources: the application icon (reused from the old ntrshd_) and
   version information.  Built by rc into ntrshd.res and linked into the exe.
   Kept simple so it compiles on the NT 3.1, 3.5 and 4.0 resource compilers. */

#include "windows.h"

1 ICON "ntrshd.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1,3,2,0
    PRODUCTVERSION 1,3,2,0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904E4"
        {
            VALUE "CompanyName",      "github.com/tenox7/ntrshd\0"
            VALUE "FileDescription",  "RSH/RCP daemon for Windows NT\0"
            VALUE "FileVersion",      "1.3.2\0"
            VALUE "LegalCopyright",   "tenox\0"
            VALUE "OriginalFilename", "ntrshd.exe\0"
            VALUE "ProductName",      "ntrshd - RSH daemon for Windows NT\0"
            VALUE "ProductVersion",   "1.3.2\0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x0409, 0x04E4
    }
}
